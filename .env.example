# ==============================================================================
# CipherVote Environment Configuration
# ==============================================================================

# Admin Authentication
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin2026

# Portal Base URL (included in email links sent to voters)
PORTAL_BASE_URL=http://localhost:3000

# Database Connection
DATABASE_URL=sqlite+aiosqlite:///./securevote.db

# ------------------------------------------------------------------------------
# SMTP Email Delivery Configuration
# ------------------------------------------------------------------------------
# When SMTP_HOST is left empty, CipherVote operates in DEV OUTBOX mode:
# All emails are stored in the database outbox and saved as .eml/.html files
# in data/outbox/ where they can be previewed directly in the Admin Console.
#
# To connect a real mailbox (e.g. Gmail):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=your_institution_email@gmail.com
#   SMTP_PASSWORD=your_16_char_google_app_password
#   SMTP_FROM=your_institution_email@gmail.com
#   SMTP_FROM_NAME=SecureVote
#   SMTP_USE_TLS=true
#   SMTP_USE_SSL=false
#
# Note for Gmail users:
#   Gmail strictly requires the envelope and From address to match your authenticated
#   Google Account (SMTP_USER). SecureVote automatically ensures the From header aligns
#   with SMTP_USER when host is smtp.gmail.com to pass DKIM and SPF checks.
#
# To test with a local mail catcher (e.g., Mailpit / MailHog on port 1025):
#   SMTP_HOST=localhost
#   SMTP_PORT=1025
#   SMTP_USER=
#   SMTP_PASSWORD=
#   SMTP_FROM=noreply@ciphervote.org
#   SMTP_FROM_NAME=SecureVote
#   SMTP_USE_TLS=false
#   SMTP_USE_SSL=false

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@ciphervote.org
SMTP_FROM_NAME=SecureVote
SMTP_USE_TLS=true
SMTP_USE_SSL=false
